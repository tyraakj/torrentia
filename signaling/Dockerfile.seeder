FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/torrentia-seeder ./cmd/seeder

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/torrentia-seeder /usr/local/bin/torrentia-seeder
COPY seeder-entrypoint.sh /usr/local/bin/seeder-entrypoint.sh
RUN chmod +x /usr/local/bin/seeder-entrypoint.sh
VOLUME ["/var/lib/torrentia-seeder"]
EXPOSE 9090
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q --spider http://127.0.0.1:${PORT:-9090}/health || exit 1
ENTRYPOINT ["/usr/local/bin/seeder-entrypoint.sh"]
