FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/torrentia-broker ./cmd/broker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/torrentia-broker /usr/local/bin/torrentia-broker
EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q --spider http://127.0.0.1:${PORT:-8082}/health || exit 1
ENTRYPOINT ["/usr/local/bin/torrentia-broker"]
