# Upload Broker Microservice (Spec 18)
# Zero client-side Pinata credentials; IPFS pinning is mediated via the Go Upload Broker.
VITE_UPLOAD_BROKER_URL=https://torrentia-upload-broker.onrender.com

# Envio HyperIndex GraphQL Service (Spec 20 - Metropolis "Best Use of Envio" Bounty)
