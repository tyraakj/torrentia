# ============================================================
# Monad contract deployment (local machine only)
# ============================================================
DEPLOYER_PRIVATE_KEY=0xYOUR_MONAD_TESTNET_PRIVATE_KEY
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONADSCAN_URL=https://testnet.monadscan.com

# Deployed Monad Testnet contracts
MODEL_REGISTRY_ADDRESS=0xe2cEDee4817B11716728aed3C3d7AD0438813340
SPLIT_PAYMENT_ADDRESS=0xFF9c3ce76Eba5647a7d22DF9A8b699d91F4bbdDa

# ============================================================
# Vercel frontend environment variables
# ============================================================
VITE_MODEL_REGISTRY_ADDRESS=0xe2cEDee4817B11716728aed3C3d7AD0438813340
VITE_SPLIT_PAYMENT_ADDRESS=0xFF9c3ce76Eba5647a7d22DF9A8b699d91F4bbdDa
VITE_MODEL_REGISTRY_DEPLOYMENT_BLOCK=0x3ce5c19
VITE_PINATA_JWT=YOUR_RESTRICTED_PINATA_JWT
VITE_SIGNALING_URL=wss://torrentia-signaling.onrender.com/ws

# ============================================================
# Render signaling service
# ============================================================
# Render provides PORT automatically. Local default: 8081.
PORT=8081

# ============================================================
# Optional Node/TS indexer
# ============================================================
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
INDEXER_PORT=8082
INDEXER_DEPLOYMENT_BLOCK=0
